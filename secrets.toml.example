# Vorlage für .streamlit/secrets.toml — kopieren und anpassen:
#   cp secrets.toml.example .streamlit/secrets.toml
# Die echte Datei ist gitignored und darf nicht committet werden.

# Demo-Passwörter für die beim ersten Start angelegten Accounts.
# Benutzername = Vorname (kleingeschrieben); "arzt" ist der Arzt-Account.
[demo_passwords]
arzt = "arzt123"
ruth = "ruth123"
jonas = "jonas123"
anita = "anita123"
werner = "werner123"
lena = "lena123"
markus = "markus123"

# Optional: abweichender Pfad zur SQLite-Datenbank (relativ zum Projektordner).
[database]
path = ""
